# Raju Kirana Store - Environment Configuration Template

# Database Configuration
# For PostgreSQL (Production):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/raju_kirana
# For SQLite (Local Development default):
DATABASE_URL=sqlite:///./raju_kirana.db

# Security & JWT Token Key (Generate a random 32+ character string in production)
SECRET_KEY=replace_with_a_long_random_cryptographic_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First-time Administrator Setup (Auto-seeded if no admin exists)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@rajukirana.local
FIRST_ADMIN_PASSWORD=RajuKirana@2026

# Uploads Directory (Persistent storage for product photos)
UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma-separated in frontend/backend)
# FRONTEND_URL=http://localhost:5173
